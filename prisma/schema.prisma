generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (Better Auth managed shape: core + admin plugin) ----------

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  emailVerified   Boolean        @default(false)
  image           String?
  phone           String?
  role            String?        @default("STAFF")
  banned          Boolean?       @default(false)
  banReason       String?
  banExpires      DateTime?
  approvalStatus  ApprovalStatus @default(APPROVED)
  allowedSections String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions Session[]
  accounts Account[]

  stockOrders      StockOrder[] @relation("StockOrderCreatedBy")
  ordersCreated    Order[]      @relation("OrderCreatedBy")
  paymentsRecorded Payment[]    @relation("RecordedPayments")
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Business profile / settings ----------

model BusinessProfile {
  id            Int      @id @default(1)
  businessName  String
  logoUrl       String?
  address       String?
  taxNumber     String?
  currencyCode  String   @default("ZAR")
  timezone      String   @default("Africa/Johannesburg")
  invoicePrefix String   @default("INV")
  updatedAt     DateTime @updatedAt
}

// ---------- Domain ----------

enum StockOrderStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  MOBILE_MONEY
  OTHER
}

model FinishedProduct {
  id           String   @id @default(cuid())
  name         String
  description  String?
  unitSize     String?
  sellPrice    Decimal  @db.Decimal(12, 2)
  stockQty     Int      @default(0)
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  isCombo      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems      OrderItem[]
  stockOrderItems StockOrderItem[]
  comboItems      ComboItem[]           @relation("ComboContents")
  inCombos        ComboItem[]           @relation("ComboComponent")
  stockDeductions OrderStockDeduction[]
}

// A line in a combo: either a product (taken from stock when the combo sells) or a
// free-text item such as packaging that isn't stock-counted (productId null, description set).
model ComboItem {
  id          String           @id @default(cuid())
  combo       FinishedProduct  @relation("ComboContents", fields: [comboId], references: [id], onDelete: Cascade)
  comboId     String
  product     FinishedProduct? @relation("ComboComponent", fields: [productId], references: [id], onDelete: Restrict)
  productId   String?
  description String?
  quantity    Int
  position    Int              @default(0)
}

model StockOrder {
  stockOrderSeq Int              @id @default(autoincrement())
  id            String           @unique @default(cuid())
  status        StockOrderStatus @default(ORDERED)
  receivedAt    DateTime?        @db.Timestamptz(3)
  total         Decimal          @db.Decimal(12, 2)
  createdBy     User             @relation("StockOrderCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items StockOrderItem[]
}

model StockOrderItem {
  id           String          @id @default(cuid())
  stockOrder   StockOrder      @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)
  stockOrderId String
  product      FinishedProduct @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int
  unitCost     Decimal         @db.Decimal(12, 2)
  lineTotal    Decimal         @db.Decimal(12, 2)
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders     Order[]
  invoices   Invoice[]
  deliveries Delivery[]
}

model Order {
  orderSeq      Int         @id @default(autoincrement())
  id            String      @unique @default(cuid())
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items           OrderItem[]
  stockDeductions OrderStockDeduction[]
  invoice         Invoice?
  delivery        Delivery?
}

// What an order actually took out of stock (combos expanded into their products),
// so cancelling restores exactly that even if a combo's contents change later.
model OrderStockDeduction {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   FinishedProduct @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
}

model OrderItem {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     FinishedProduct @relation(fields: [productId], references: [id])
  productId   String
  description String
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  lineTotal   Decimal         @db.Decimal(12, 2)
}

model Delivery {
  id           String         @id @default(cuid())
  order        Order          @relation(fields: [orderId], references: [id])
  orderId      String         @unique
  customer     Customer       @relation(fields: [customerId], references: [id])
  customerId   String
  status       DeliveryStatus @default(PENDING)
  address      String
  scheduledAt  DateTime?      @db.Timestamptz(3)
  dispatchedAt DateTime?      @db.Timestamptz(3)
  deliveredAt  DateTime?      @db.Timestamptz(3)
  courierName  String?
  trackingRef  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Invoice {
  invoiceSeq    Int           @id @default(autoincrement())
  id            String        @unique @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @unique
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?     @db.Timestamptz(3)
  dueAt         DateTime?     @db.Timestamptz(3)
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId    String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now()) @db.Timestamptz(3)
  recordedBy   User          @relation("RecordedPayments", fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime      @default(now())
}
